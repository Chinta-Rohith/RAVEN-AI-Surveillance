# ==============================================================================
# RAVEN Frontend Environment Variables (Vercel & Vite)
# ==============================================================================

# Optional: Production Backend API URL (e.g. Render, Railway, Fly.io, or VPS)
# Leave empty to use relative /api routes proxied by vercel.json
VITE_API_URL=

# Optional: Production Persistent WebSocket URL
# Example: wss://your-backend.up.railway.app/ws/stream
# If omitted, defaults to wss://${window.location.host}/ws/stream
VITE_WS_URL=
