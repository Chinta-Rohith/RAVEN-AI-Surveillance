{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "node -e \"const fs=require('fs'); if(fs.existsSync('frontend')){process.chdir('frontend');} require('child_process').execSync('npm run build',{stdio:'inherit'});\"",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
