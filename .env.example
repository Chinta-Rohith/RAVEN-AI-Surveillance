# ==========================================
# RAVEN Configuration Environment
# Real-time Agentic Vision for UAV Navigation
# Based on DeTrAck (IEEE Access 2025)
# ==========================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security & Authentication (Argon2id + JWT)
# In production, generate a high-entropy secret (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Security Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300

# Email Delivery Configuration
# Mode: "development" (safe simulated email in dev logs) or "smtp" (live provider)
EMAIL_MODE=development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@raven-surveillance.io
SMTP_FROM_NAME="RAVEN AI Surveillance Platform"
APP_URL=http://localhost:5173

# Inference Device (cpu / cuda / auto)
DEVICE=cpu

# Detection (YOLO11)
YOLO_MODEL_PATH=models/yolo11s.pt
YOLO_CONFIDENCE_THRESHOLD=0.20
YOLO_IOU_THRESHOLD=0.45

# Validation (VaL_CNN)
VAL_CNN_MODEL_PATH=models/val_cnn.pt
VAL_CNN_CONFIDENCE_THRESHOLD=0.50
VAL_CNN_INPUT_SIZE=64

# Ensemble Parameters
# S_Ens = alpha * S_YOLO + (1 - alpha) * S_VaL
ENSEMBLE_ALPHA=0.70
ENSEMBLE_ACCEPT_THRESHOLD=0.50

# DeepSORT Tracking
DEEPSORT_MAX_AGE=30
DEEPSORT_N_INIT=3
DEEPSORT_NN_BUDGET=100
DEEPSORT_MAX_COSINE_DISTANCE=0.25

# PTZ Control & Boundary
# 10% Boundary margin triggers recentering
PTZ_BOUNDARY_RATIO=0.10
# Mode: SIMULATION or ONVIF
PTZ_MODE=SIMULATION
KP_PAN=0.40
KP_TILT=0.40
PTZ_MAX_SPEED=0.80

# ONVIF Camera (Used only when PTZ_MODE=ONVIF)
ONVIF_HOST=
ONVIF_PORT=80
ONVIF_USERNAME=
ONVIF_PASSWORD=

# Database Path
DATABASE_PATH=logs/raven_telemetry.db
